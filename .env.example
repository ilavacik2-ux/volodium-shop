# ==============================================================================
# VOLODIUM PARFUM — CONFIGURATION EXAMPLE (.env)
# ==============================================================================
# Скопируйте в .env и задайте свои уникальные секретные значения:
#   cp .env.example .env
#
# ВАЖНО: Никогда не публикуйте .env в Git или публичные репозитории!
# ==============================================================================

# Среда выполнения: development | production
VP_ENV=development

# Сетевая привязка сервера Uvicorn
# Для VDS за Nginx/Caddy ОБЯЗАТЕЛЬНО: 127.0.0.1
VP_HOST=127.0.0.1
VP_PORT=8000

# Настройки обратного прокси (Nginx / Caddy)
# Доверяем X-Real-IP / X-Forwarded-For ТОЛЬКО если TCP-соединение пришло от доверенного прокси
VP_BEHIND_PROXY=false
VP_TRUSTED_PROXIES=127.0.0.1,::1

# Доверенные источники CORS (через запятую, БЕЗ *)
VP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://volodiumparfum.ru,https://www.volodiumparfum.ru

# Скрытый маршрут шлюза админ-панели (по умолчанию нестандартный URL)
# Без валидного ?token=... этот и все стандартные админ-адреса отдают чистый 404
VP_ADMIN_PATH=/vp-atelier

# Два раздельных секретных токена-шлюза (минимум 24+ случайных символа)
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
VP_GATEWAY_TOKEN_OWNER=CHANGE_ME_OWNER_TOKEN_32_CHARS
VP_GATEWAY_TOKEN_ASSISTANT=CHANGE_ME_ASSISTANT_TOKEN_32_CHARS

# Начальный пароль входа в админку (при старте автоматически хэшируется PBKDF2-HMAC-SHA256 в БД)
VP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Секретный ключ подписи сессий и HMAC-куки (минимум 32+ символа)
VP_SECRET_KEY=CHANGE_ME_HMAC_SECRET_KEY_32_CHARS

# Защита от перебора пароля и токенов
VP_MAX_LOGIN_ATTEMPTS=5
VP_LOCKOUT_MINUTES=15
VP_MAX_GATE_FAILS=12
VP_GATE_LOCKOUT_MINUTES=30
